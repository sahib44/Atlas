POSTGRES_USER=mist
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=mist
SEED_PASSWORD=replace-with-a-local-demo-password
COOKIE_SECURE=false
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_ROWS=5000
API_PORT=8008
WEB_PORT=5180

# Optional separate local demo-role passwords (blank falls back to SEED_PASSWORD).
COMPETITIONS_CHAIR_PASSWORD=
COMPETITIONS_MEMBER_PASSWORD=

# Private deployments use managed mode and skip demo seeding.
# Use an HTTPS origin and a secret generated with Python secrets.token_urlsafe(48).
MIST_ACCOUNT_MODE=sandbox
MIST_PUBLIC_ORIGIN=
MIST_ACCOUNT_TOKEN_KEY=
MIST_ALLOW_TEST_ACCOUNT_LINKS=false
